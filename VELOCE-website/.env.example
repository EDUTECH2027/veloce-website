# Gmail account that SENDS the notification (not the recipient).
# Use a Google "App password" (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-char-app-password
# Sender address shown in "From" (must be verified in Brevo). Defaults to SMTP_USER.
SMTP_FROM=francisjunior269@gmail.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
